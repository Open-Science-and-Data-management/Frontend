# Where the browser sends API requests. In development keep /api: Vite proxies
# it to BACKEND_URL, so the browser sees one origin and the backend needs no
# CORS. For a production build, set the URL the API is served from (same
# origin is required for the refresh cookie).
VITE_API_URL=/api

# Dev server only: where the Vite proxy forwards /api.
BACKEND_URL=http://localhost:3000
